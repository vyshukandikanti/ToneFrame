# Server Port
PORT=5000

# Base paths
BASE_PATH=/

# Database URLs
DATABASE_URL=postgresql://postgres:password123@localhost:5432/dubverse

# Redis Connection URL
REDIS_URL=redis://localhost:6379

# JSON Web Token secret key
JWT_SECRET=supersecretjwtkey12345!

# AI API Keys
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# AWS S3 Storage Credentials & configurations
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadminpassword
AWS_REGION=us-east-1
S3_BUCKET=dubverse-bucket
# Endpoint is optional for local development with MinIO
AWS_ENDPOINT_URL_S3=http://localhost:9000

# Pipeline Provider Configurations
# Whisper providers: "mock" | "replicate"
WHISPER_PROVIDER=mock

# Translation providers: "mock" | "gemini" | "openai"
TRANSLATION_PROVIDER=mock

# Voice providers: "mock" | "elevenlabs" | "fishspeech" | "cosyvoice" | "indus"
VOICE_PROVIDER=mock

# LipSync providers: "mock" | "wav2lip" | "musetalk" | "sadtalker"
LIPSYNC_PROVIDER=mock

# Rendering providers: "ffmpeg" | "remotion" | "cloud"
RENDERING_PROVIDER=ffmpeg

# Sentry analytics DSN
SENTRY_DSN=

# Production Credentials (Hugging Face and Replicate)
# Required for text/audio emotion and NLLB translation via Inference API
HF_TOKEN=your_hugging_face_token_here
# Required for Pyannote speaker diarization, Wav2Lip, MuseTalk, and SadTalker lip sync
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Provider API Keys
# Required for Fish Speech voice cloning
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
# Required for ElevenLabs voice generation
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Local AI microservices Endpoint URLs (Defaults shown)
COSYVOICE_URL=http://127.0.0.1:50000
INDUS_URL=http://127.0.0.1:40000
FASTER_WHISPER_URL=http://127.0.0.1:8000
LOCAL_WHISPER_CLI=whisper
WHISPERX_CLI=whisperx
NEMO_SCRIPT_PATH=

