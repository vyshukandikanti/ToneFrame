# ==============================================================================
# DubVerse AI Production Environment Variable Template
# ==============================================================================
# Copy this file to .env and configure the values for your live infrastructure.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATIONS (Vite environment prefix: VITE_)
# ------------------------------------------------------------------------------
# Base API URL of your deployed Express server (e.g. https://api.dubverse.ai)
VITE_API_URL=https://api.yourdomain.com

# Socket.io connection URL of your backend server (e.g. https://api.dubverse.ai)
VITE_SOCKET_URL=https://api.yourdomain.com

# Optional base path for asset serving (Default is "/")
BASE_PATH=/

# ------------------------------------------------------------------------------
# 2. BACKEND & WORKER CORE CONFIGURATIONS
# ------------------------------------------------------------------------------
# Server Port (Railway/Render typically assign this dynamically via $PORT)
PORT=5000

# Node Environment ("production" for live deployments)
NODE_ENV=production

# JSON Web Token Secret Key (Must be a secure, random cryptographically generated string)
JWT_SECRET=generate-a-secure-random-jwt-key-64-chars-long!

# Sentry analytics DSN for error logs collection
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project-id

# ------------------------------------------------------------------------------
# 3. MANAGED DATASTORES
# ------------------------------------------------------------------------------
# Managed PostgreSQL Connection URI (neon.tech, supabase.com, etc. Ensure sslmode=require)
DATABASE_URL=postgresql://db_user:db_password@db_host.neon.tech/dubverse?sslmode=require

# Managed Redis URL (upstash.com, railway redis, etc.)
REDIS_URL=rediss://default:redis_password@redis_host.upstash.io:6379

# ------------------------------------------------------------------------------
# 4. MANAGED CLOUD OBJECT STORAGE (Cloudflare R2 or AWS S3)
# ------------------------------------------------------------------------------
# S3/R2 Access Credential Key
AWS_ACCESS_KEY_ID=your_access_key_id_here

# S3/R2 Access Credential Secret
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Name of your deployed storage bucket
S3_BUCKET=your-production-bucket-name

# Bucket Region (e.g., us-east-1 or auto for Cloudflare R2)
AWS_REGION=us-east-1

# Optional: Endpoint override URL (e.g. https://<account_id>.r2.cloudflarestorage.com for R2)
AWS_ENDPOINT_URL_S3=

# ------------------------------------------------------------------------------
# 5. PRODUCTION AI PROVIDERS CREDENTIALS & API KEYS
# ------------------------------------------------------------------------------
# Hugging Face Access Token (Required for NLLB translation, Text/Audio Emotion classification)
HF_TOKEN=hf_your_hugging_face_token_here

# Replicate API Access Token (Required for Pyannote Diarization, Wav2Lip, MuseTalk, SadTalker)
REPLICATE_API_TOKEN=r8_your_replicate_token_here

# OpenAI API Key (Required for GPT translations or transcription)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Gemini API Key (Required for Gemini translation prompts)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Fish Audio API Key (Required for Fish Speech voice clones synthesis)
FISH_AUDIO_API_KEY=your_fish_audio_key_here

# ElevenLabs API Key (Required for ElevenLabs voice clones synthesis)
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ------------------------------------------------------------------------------
# 6. PIPELINE PROVIDER SELECTIONS
# ------------------------------------------------------------------------------
# Choose: "mock" | "replicate" (for openai) | "local" | "faster-whisper"
WHISPER_PROVIDER=replicate

# Choose: "mock" | "gemini" | "openai" | "nllb" | "seamless"
TRANSLATION_PROVIDER=gemini

# Choose: "mock" | "elevenlabs" | "fishspeech" | "cosyvoice" | "indus"
VOICE_PROVIDER=fishspeech

# Choose: "mock" | "wav2lip" | "musetalk" | "sadtalker"
LIPSYNC_PROVIDER=wav2lip

# Choose: "ffmpeg" | "remotion" | "cloud"
RENDERING_PROVIDER=ffmpeg
